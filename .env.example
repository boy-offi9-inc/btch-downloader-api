# Port the API server listens on
PORT=3000

# Comma-separated list of allowed CORS origins ("*" allows all — fine for local testing)
CORS_ORIGIN=*

# Rate limit: max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Max time (ms) to wait for the downloader library on /api/download (default 25000)
DOWNLOAD_TIMEOUT_MS=25000

# In-memory cache of successful /api/download responses.
# CACHE_TTL_MS=0 disables it. Keep the TTL short — media links can expire.
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=200
