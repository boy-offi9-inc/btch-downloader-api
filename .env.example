# Port the API server listens on
PORT=3000

# Comma-separated list of allowed CORS origins ("*" allows all — fine for local testing)
# Examples: CORS_ORIGIN=https://myapp.com   or   CORS_ORIGIN=https://a.com,https://b.com
CORS_ORIGIN=*

# Reverse-proxy hops to trust for the client IP (so rate limiting sees the
# real caller). Unset = 1 on Vercel, 0 elsewhere. Use a number (e.g. 1), or
# "false" to disable. Never set this to trust an unbounded chain.
# TRUST_PROXY=1

# Rate limit: max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Max time (ms) to wait for the downloader library on /api/download (default 25000)
DOWNLOAD_TIMEOUT_MS=25000

# In-memory cache of successful /api/download responses.
# CACHE_TTL_MS=0 disables it. Keep the TTL short — media links can expire.
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=200

# --- /api/fetch-media ---
# Separate, tighter rate limit (per IP per window) for the file-streaming route.
FETCH_MEDIA_RATE_LIMIT_MAX=10
# Optional: only proxy media from these hosts (and their subdomains). Empty = any
# public host. Private/internal addresses are always refused either way.
# FETCH_MEDIA_ALLOWED_HOSTS=googlevideo.com,tiktokcdn.com,cdninstagram.com
# Optional: refuse/abort files bigger than this many bytes (0 = no cap).
FETCH_MEDIA_MAX_BYTES=0
# Connect + response-headers timeout (ms). Does not limit the transfer itself.
FETCH_MEDIA_TIMEOUT_MS=20000

# Optional: send "Cache-Control: public, s-maxage=N" on successful /api/download
# responses so a CDN (e.g. Vercel's edge) can cache them. 0 = off.
EDGE_CACHE_SECONDS=0
